# Copy to .env and fill in. .env is gitignored — keys never enter the repo.

# Host directory for the HuggingFace cache (checkpoints download here on
# first boot; ~52 GB BF16 / ~28 GB FP8 / ~23 GB NVFP4 / ~18 GB AWQ micro).
HF_CACHE_DIR=/data/hf-cache

# File containing your Brave Search API key (https://brave.com/search/api/),
# one line, no trailing newline needed. Powers Claude Code's WebSearch tool.
BRAVE_API_KEY_FILE=./secrets/brave-api-key

# LiteLLM proxy master key — pick any secret; clients authenticate with it.
LITELLM_MASTER_KEY=sk-change-me

# Long-video variant (compose.fp8.video.yaml) only: host directory served
# read-only at /videos inside the worker for file:// video ingest.
VIDEO_DIR=./videos

# Optional overrides (defaults shown).
#VLLM_PORT=8000
#LITELLM_PORT=4000
#WEBSEARCH_DAILY_LIMIT=500

# Small-card tiers (compose.nvfp4.small.yaml / compose.awq.micro.yaml) only:
# fraction of total VRAM vLLM may use. Lower it if your desktop already
# holds significant VRAM (check nvidia-smi), then lower --max-model-len in
# the compose file to match (~26K tokens of context per GiB).
#GPU_MEMORY_UTILIZATION=0.95
