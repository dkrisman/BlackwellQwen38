# Image pin set. Editing this file (on main) triggers the build-images
# workflow, which publishes:
#   ghcr.io/dkrisman/bq38-vllm:${PIN}
#   ghcr.io/dkrisman/bq38-litellm:${PIN}
# The bq38-N tags on the three forks are immutable; cut new tags and bump PIN
# together. VLLM_WHEEL_SHA stays empty when VLLM_BASE_IMAGE was built from the
# fork ref's upstream merge-base; otherwise set it to that merge-base commit
# (see docker/vllm.Dockerfile). Nightly image tags are pruned from Docker Hub
# after a few days, so a durable pin uses a release image as VLLM_BASE_IMAGE
# with VLLM_WHEEL_SHA set.
PIN=bq38-6
VLLM_BASE_IMAGE=vllm/vllm-openai:v0.27.1
VLLM_REF=bq38-6
VLLM_WHEEL_SHA=aa9903490c616dc6871e5acc62cec7bb1e5e9434
TRANSFORMERS_REF=bq38-6
LITELLM_BASE_IMAGE=ghcr.io/berriai/litellm:v1.98.0-rc.1
LITELLM_REF=bq38-6
PLUGIN_REF=main
